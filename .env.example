# Copy to `.env` (never commit it). Real environment variables / HF Space secrets override this file.

# ---- Which AI judge reads the transcript -----------------------------------------------------------
# auto | gemini | groq | openai | ollama | none
# auto = first configured provider in LLM_AUTO_ORDER. Change this ONE line to switch providers.
LLM_PROVIDER=gemini
# LLM_AUTO_ORDER=gemini,groq,openai,ollama

# Explicit consent to send DE-IDENTIFIED TRANSCRIPT TEXT (never audio/video/frames) to a cloud API.
ALLOW_EXTERNAL_LLM=1

# ---- Gemini (free key from Google AI Studio) ---------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_REASONING_EFFORT=low     # thinking models: low keeps answers fast and within the token budget
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3-flash-preview   # tried in order; free quotas are per model
# Note: Google's free tier may use submitted content to improve its products (see Google's Gemini API terms).

# ---- Groq (free key from console.groq.com) -----------------------------------------------------------
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ---- Jev (TypeSafe): fast, cheap yes/no DECIDER. Opt-in: set LLM_PROVIDER=jev (never auto-selected) ------
# Jev returns probabilities only, so it is used with retrieval: confident answers are accepted, unsure ones are escalated
# to the generative provider (JEV_ESCALATE_TO=auto|gemini|groq|openai|ollama|none), which also writes the retrieval hints.
# Paid per use (about $0.04 per million input tokens). Direct API or via OpenRouter:
# JEV_API_KEY=
# JEV_ENDPOINT=typesafe          # or: openrouter (then set OPENROUTER_API_KEY; model becomes typesafe/jev-1.13)
# JEV_MODEL=jev-latest
# JEV_YES_AT=0.65                # probability at/above which an answer is accepted as yes
# JEV_NO_AT=0.35                 # probability at/below which an answer is accepted as no
# JEV_ESCALATE_TO=auto

# ---- Any other OpenAI-compatible API -------------------------------------------------------------------
# LLM_BASE_URL=https://example.com/v1
# LLM_MODEL=some-model
# LLM_API_KEY=

# ---- Local and private (no data leaves the machine): `ollama serve` + `ollama pull qwen2.5:3b-instruct` ---
# OLLAMA_MODEL=qwen2.5:3b-instruct

# ---- Other ----------------------------------------------------------------------------------------------
# Speech-to-text model size for faster-whisper: tiny | base | small | medium
WHISPER_MODEL=small
# Branded-background check: path to a reference logo image, or empty to disable
# BRAND_TEMPLATE=assets/logo_template.png
